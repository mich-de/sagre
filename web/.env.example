# Google Calendar (public calendar, browser key restricted by HTTP referrer)
VITE_GOOGLE_CALENDAR_API_KEY=
VITE_GOOGLE_CALENDAR_ID=

# OAuth web client ID — only needed to WRITE events from the admin page
# (create / move / delete). Reading works with the API key alone. Leave it
# empty and the admin simply hides the calendar-writing controls.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Firebase web app config (safe to expose client-side — protection is
# Firestore security rules + Google Identity, not secrecy of these values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
